# BEFORE embeds.xml on purpose: it snapshots LibStub.minors as it was before our libraries loaded,
# which is the only moment that snapshot can be taken. Core/Init.lua seals the second one.
# Without the ordering, /elm debug libs cannot tell our copies from everyone else's.
Adapters\LibOwner.lua

embeds.xml

# Adapters (State contract first) — Adapters\Vanilla.lua is the only file in Elmira/ that names a WoW global
Adapters\Interface.lua
Adapters\Swing.lua
Adapters\Vanilla.lua
Adapters\Collector.lua
Adapters\ItemRack.lua

# Core — pure Lua, no WoW API (hard rule 3)
Core\Colors.lua
Core\API.lua
Core\Packs.lua
Core\DB.lua
Core\Announce.lua
Core\Schema.lua
Core\Gates.lua
Core\Serialize.lua
Core\UserBuilds.lua
Core\Engine.lua
Core\Simulation.lua
Core\Profiles.lua
Core\Advisor.lua
Core\Visibility.lua
Core\Ticker.lua
Core\MemProbe.lua
Core\Transition.lua
Core\Palette.lua
# After Palette and Gates: the editor's condition model borrows "can you press this" from one
# and the wording of a static gate from the other, rather than keeping second copies of either.
Core\Conditions.lua
# R2 (D53): the Spells registry. After Conditions.lua -- Spells.referencedKeys walks a build's
# conditions through Conditions.field() to find every spell key one names.
Core\Spells.lua
# Reads Schema's own KEY_SOURCE, so it follows Schema.
Core\Diagnostics.lua
Core\Recorder.lua
Core\Slash.lua

# Display — frames and textures. May name presentation globals (see .luacheckrc), never state ones.
Display\Driver.lua
Display\Glow.lua
Display\BarGlow.lua
Display\BarProviders.lua
Display\Queue.lua
Display\Overlay.lua
Display\Announcers.lua
# D2: the one StaticPopup_Show call site in the addon. Loads before Setup\Wizard.lua and
# Options\Rotation.lua, both of which use ns.Popups, so neither has to reach forward for it.
Display\Popups.lua

# Setup
Setup\Detect.lua
Setup\Wizard.lua

# Options
# W1 (try/card-widget, 2026-09-07): a self-contained AceGUI widget, registered before Rotation.lua
# builds any option that names it as a `dialogControl` -- though the registration itself happens at
# file scope regardless of order, since Rotation.lua only READS the type name when a page opens.
Options\CardWidget.lua
Options\Rotation.lua
# R2 (D52): before Options.lua, which reads ns.SpellsPage.group() into the top-level tree.
Options\Spells.lua
Options\Options.lua

# Shipped class data (ADR-0011). Each file registers a THUNK -- it must construct nothing at load,
# because WoW executes every file here on every character regardless of class. Ordered after the
# Core file that defines ns.RegisterBuiltinPack, and before the entry point that calls the thunk.
# (Naming those two files here would break toc_spec, which locates entries by their first mention.)
Classes\Paladin.lua

# Entry point last
Core\Init.lua
